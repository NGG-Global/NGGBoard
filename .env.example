# ============================================================================
# NGG Boards — environment variables
# Copy to `.env.local` and fill in when connecting a Supabase backend.
# The app runs fully WITHOUT these using the built-in local (browser) backend.
# ============================================================================

# Which data backend to use: "local" (default, no server) or "supabase".
NEXT_PUBLIC_DATA_BACKEND=local

# --- Supabase (only needed when NEXT_PUBLIC_DATA_BACKEND=supabase) ----------
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Server-only key for the inactivity sweep Edge Function / admin tasks.
# NEVER expose this to the client.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Public base URL used to build participant join links / QR codes.
# Falls back to window.location.origin when unset.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Giphy (GIF & sticker submissions) ---------------------------------------
# Server-only key used by the /api/giphy proxy route; it is never sent to the
# browser (deliberately NOT prefixed with NEXT_PUBLIC_). Without it, the GIF
# picker shows a "temporarily unavailable" state. Create a key at
# https://developers.giphy.com/.
GIPHY_API_KEY=your-giphy-api-key

# --- YouTube (video submissions) ---------------------------------------------
# Server-only key for the /api/youtube search proxy (YouTube Data API v3;
# create one in Google Cloud Console and enable the "YouTube Data API v3").
# Never sent to the browser (deliberately NOT prefixed with NEXT_PUBLIC_).
# Without it, participants can still PASTE a video link — only search is
# disabled. NOTE: each search costs 100 quota units of the default 10,000/day
# (≈100 searches/day); the picker's opening "most popular" list costs 1 unit.
YOUTUBE_API_KEY=your-youtube-data-api-key
